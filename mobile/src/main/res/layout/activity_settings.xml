<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorWindowBg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <!-- RECORDING -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="Recording" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SettingsItemTitle"
                    android:text="Clip length" />

                <TextView
                    style="@style/SettingsItemSubtitle"
                    android:text="How long each loop segment is. Shorter clips lose less footage on a power-cut." />

                <LinearLayout
                    android:id="@+id/group_clip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <View style="@style/SettingsDivider" />

                <TextView
                    style="@style/SettingsItemTitle"
                    android:text="Resolution" />

                <LinearLayout
                    android:id="@+id/group_res"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Video stabilization" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Smooth out road bumps using the camera's electronic stabilization (if supported). Slightly narrows the field of view." />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_stabilization"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- NIGHT MODE -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="Night mode" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Scheduled night mode" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Automatically switch the camera to night scene mode during the scheduled time (if the camera supports it)" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_night"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <!-- Schedule editor: only visible while the switch is on. -->
                <LinearLayout
                    android:id="@+id/night_schedule_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/SettingsDivider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/night_start_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="6:00 PM"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginEnd="8dp"
                            android:text="\u2192"
                            android:textColor="@color/colorTextSecondary"
                            android:textSize="20sp" />

                        <TextView
                            android:id="@+id/night_end_chip"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:text="6:00 AM"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <TimePicker
                        android:id="@+id/night_time_picker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:timePickerMode="spinner"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- STORAGE -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="Storage" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Storage limit" />

                        <TextView
                            android:id="@+id/storage_free"
                            style="@style/SettingsItemSubtitle"
                            android:text="Maximum space used for the rolling buffer" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/storage_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="1 GB"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.slider.Slider
                    android:id="@+id/storage_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:stepSize="1"
                    android:valueFrom="1"
                    android:valueTo="128" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SAFETY -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="Automation" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Start recording when charging" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Automatically start the dashcam when the car powers on (charger connected)" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_autostart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Stop recording when unplugged" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Automatically stop the dashcam when the car powers off (charger disconnected)" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_autostop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Auto-pause when parked" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Pause recording when the vehicle stays still beyond the timeout, and resume automatically when it moves again. Uses motion sensors only (no internet)." />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_autopause"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_autopause"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- SAFETY -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="Safety" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Overheating alert" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Warn me when the battery gets too hot" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_overheat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_overheat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Auto shutdown on low battery" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Safely stop and quit when the battery is low and not charging" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_lowbatt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_lowbatt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Overcharge protection" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Warns you to unplug once the battery reaches the limit while charging (re-arms after it drops 10% below). On rooted/supported devices it also pauses charging automatically." />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_overcharge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_overcharge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- GENERAL -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="General" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Silent" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Mute system sound while recording" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_silent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Record audio" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Capture microphone sound in recordings. Turn off for video-only clips." />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_record_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Start Maps in background" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="Launch Google Maps navigation when the app starts" />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_maps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        style="@style/SettingsItemTitle"
                        android:text="Add “Start Recording” to home screen" />

                    <TextView
                        style="@style/SettingsItemSubtitle"
                        android:text="Places a shortcut on your launcher that starts recording instantly. Remove it from the home screen when no longer needed." />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_add_shortcut"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_storage_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Add to home screen"
                    android:textColor="@color/colorAction"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View style="@style/SettingsDivider" />

                <TextView
                    android:id="@+id/btn_delete_all"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_delete_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Delete all recordings"
                    android:textColor="#FFD32F2F"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- EXPERIMENTAL -->
        <TextView
            style="@style/SettingsSectionHeader"
            android:text="Experimental" />

        <androidx.cardview.widget.CardView style="@style/SettingsCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SettingsItemSubtitle"
                    android:text="These features are still being tuned and may not work perfectly. Enable them at your own discretion." />

                <View style="@style/SettingsDivider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/SettingsItemTitle"
                            android:text="Camera placement check" />

                        <TextView
                            style="@style/SettingsItemSubtitle"
                            android:text="While driving, warns if the car bonnet doesn't appear along the bottom of the frame (camera aimed too high). Runs on-device, no internet." />
                    </LinearLayout>

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switch_mount_check"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
