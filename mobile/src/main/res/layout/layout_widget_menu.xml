<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:visibility="gone">

    <LinearLayout
        android:id="@+id/layout_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="@dimen/horizontal_widget_distance_large"
        android:orientation="vertical">

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/stop_and_quit_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_widget_circle"
            android:contentDescription="Stop recording"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_stop" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/home_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/vertical_widget_distance"
            android:background="@drawable/bg_widget_circle"
            android:contentDescription="Home"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_home" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/live_view_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/vertical_widget_distance"
            android:background="@drawable/bg_widget_circle"
            android:contentDescription="Live view"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_live" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/parking_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/vertical_widget_distance"
            android:background="@drawable/bg_widget_circle"
            android:contentDescription="Parking mode"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_parking" />
    </LinearLayout>
</FrameLayout>