<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Full-screen live camera feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/txt_preview_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Live preview available while recording"
        android:textColor="#FF90A4AE"
        android:textSize="14sp" />

    <!-- Close button (top-right) -->
    <TextView
        android:id="@+id/btn_close"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:background="#66000000"
        android:gravity="center"
        android:text="\u2715"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp" />

    <!-- Telemetry overlay (top): REC + speed / resolution / temperature -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingTop="14dp"
        android:paddingRight="68dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/rec_dot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="\u25CF REC"
            android:textColor="#FFFF5252"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout style="@style/HudCell">

            <TextView
                style="@style/HudLabel"
                android:text="SPEED" />

            <TextView
                android:id="@+id/txt_speed"
                style="@style/HudValueLarge"
                android:text="0 km/h" />
        </LinearLayout>

        <LinearLayout style="@style/HudCell">

            <TextView
                style="@style/HudLabel"
                android:text="RESOLUTION" />

            <TextView
                android:id="@+id/txt_resfps"
                style="@style/HudValueLarge"
                android:text="--" />
        </LinearLayout>

        <LinearLayout style="@style/HudCell">

            <TextView
                style="@style/HudLabel"
                android:text="TEMPERATURE" />

            <TextView
                android:id="@+id/txt_temp"
                style="@style/HudValueLarge"
                android:text="--" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>